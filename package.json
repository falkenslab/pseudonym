{
  "name": "@falkenslab/pseudonym",
  "version": "0.2.1",
  "description": "Stable aliases for people, so tools can tell a language model about them without names, and the person in charge can always resolve them",
  "author": "Falkenslab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkenslab/pseudonym.git"
  },
  "homepage": "https://falkenslab.github.io/pseudonym/",
  "bugs": {
    "url": "https://github.com/falkenslab/pseudonym/issues"
  },
  "keywords": [
    "pseudonymization",
    "privacy",
    "gdpr",
    "pii",
    "mcp",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "pseudonym": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "docs:install": "npm --prefix docs ci",
    "docs:start": "npm --prefix docs start",
    "docs:build": "npm --prefix docs run build",
    "docs:version": "npm --prefix docs run docs:version --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
