{
  "name": "classroom-mcp-example",
  "version": "0.0.0",
  "private": true,
  "description": "An MCP server over a made-up course that tells a model about students by alias, with @falkenslab/pseudonym",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "demo": "tsx src/demo.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@falkenslab/pseudonym": "file:../..",
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
